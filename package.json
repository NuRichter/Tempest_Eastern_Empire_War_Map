{
  "name": "tempest-eastern-empire-war-map",
  "version": "2.1.0",
  "private": true,
  "description": "Fan-made campaign atlas of the Tempest-Eastern Empire War (Tensura LN vols 12-16): canon-audited timeline, traced territories, army sizes and movements, with every reconstruction labelled. Not official Tensura material.",
  "author": "NuRichter",
  "scripts": {
    "compile-data": "tsx scripts/compile-data.ts && tsx scripts/compile-front.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "validate-assets": "tsx scripts/validate-assets.ts",
    "prebuild": "npm run compile-data && npm run validate-data && npm run validate-assets && tsx scripts/security/integrity.mts",
    "dev": "next dev",
    "build": "next build && tsx scripts/security/harden-build.mts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-runtime.ts",
    "verify": "npm run compile-data && npm run validate-data && npm run validate-assets && npm run lint && npm run security:lint && npm run typecheck && npm run i18n:extract && npm run i18n:check && npm run test && npm run security:test && npm run build",
    "qa": "tsx scripts/browser-qa.ts",
    "qa:visual": "tsx scripts/visual-regression.ts",
    "qa:playwright": "node scripts/qa-playwright.mjs",
    "qa:front": "tsx scripts/capture-front.ts",
    "qa:playback": "tsx scripts/capture-playback.ts",
    "qa:perf": "tsx scripts/perf-baseline.ts",
    "i18n:extract": "tsx scripts/i18n-extract.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "security:lint": "tsx scripts/security/lint.mts",
    "security:scan": "tsx scripts/security/scan.mts",
    "security:audit": "npm audit --omit=dev --audit-level=low",
    "security:test": "tsx scripts/security/test.mts",
    "security:browser": "tsx scripts/security/browser.mts",
    "security:preview": "tsx scripts/security/preview.mts",
    "qa:profile": "tsx scripts/profile-cinematic.mts",
    "qa:governor": "tsx scripts/qa-governor.mts",
    "qa:trace": "tsx scripts/trace-cinematic.mts"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "maplibre-gl": "~5.24.0",
    "next": "^16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "puppeteer": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.29"
    }
  }
}
