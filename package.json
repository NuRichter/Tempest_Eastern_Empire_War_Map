{
  "name": "tempest-eastern-empire-war-map",
  "version": "2.1.0",
  "private": true,
  "description": "Fan-made campaign atlas of the Tempest-Eastern Empire War (Tensura LN vols 12-16): canon-audited timeline, traced territories, army sizes and movements, with every reconstruction labelled. Not official Tensura material.",
  "author": "NuRichter",
  "scripts": {
    "compile-data": "tsx scripts/compile-data.ts && tsx scripts/compile-front.ts",
    "validate-data": "tsx scripts/validate-data.ts",
    "validate-assets": "tsx scripts/validate-assets.ts",
    "prebuild": "npm run compile-data && npm run validate-data && npm run validate-assets",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-runtime.ts",
    "verify": "npm run compile-data && npm run validate-data && npm run validate-assets && npm run lint && npm run typecheck && npm run i18n:extract && npm run i18n:check && npm run test && npm run build",
    "qa": "tsx scripts/browser-qa.ts",
    "qa:visual": "tsx scripts/visual-regression.ts",
    "qa:playwright": "node scripts/qa-playwright.mjs",
    "qa:front": "tsx scripts/capture-front.ts",
    "qa:playback": "tsx scripts/capture-playback.ts",
    "qa:perf": "tsx scripts/perf-baseline.ts",
    "i18n:extract": "tsx scripts/i18n-extract.ts",
    "i18n:check": "tsx scripts/i18n-check.ts"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^5.6.0",
    "next": "15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "^0.186.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.5.1",
    "puppeteer": "^25.10.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
